<%
# Standalone HTS page shell. Used to include a layout scraped live from
# stjornarradid.is via updateSTJRframe.sh; that stopped working when the
# mother site moved to a new CMS that no longer offers a static page to
# scrape. See git history for the old approach.
ns_adp_puts {

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="is">
<head>
<!--  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
      Björn Þór Jónsson
      bangsi@bthj.is
      ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~  -->

<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="stylesheet" type="text/css" href="/css/hts.css" />
<link rel="stylesheet" type="text/css" href="//fonts.googleapis.com/css?family=Open+Sans:400,600" />

<script src="/js/hts.js" defer></script>

</head>
<body>

<header class="hts-masthead">
  <div class="hts-masthead-inner">
    <a class="hts-crest" href="https://www.stjornarradid.is/" target="_blank" rel="noopener">Stjórnarráð Íslands</a>
    <span class="hts-masthead-sep">&middot;</span>
    <span class="hts-masthead-org">Þýðingamiðstöð utanríkisráðuneytisins</span>
  </div>
</header>

<div class="hts-page">

  }
%>
